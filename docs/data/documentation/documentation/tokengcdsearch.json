{"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Documentation\/tutorials\/Tutorial-Table-of-Contents"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"%D0%9E%D1%81%D0%BE%D0%B1%D0%B5%D0%BD%D0%BD%D0%BE%D1%81%D1%82%D0%B8-%D1%80%D0%B0%D0%B1%D0%BE%D1%82%D1%8B-%D1%81-%D0%B1%D0%B8%D0%B1%D0%BB%D0%B8%D0%BE%D1%82%D0%B5%D0%BA%D0%BE%D0%B9-rtpkcs11ecp-%D0%B2-%D0%BC%D0%BD%D0%BE%D0%B3%D0%BE%D0%BF%D0%BE%D1%82%D0%BE%D1%87%D0%BD%D0%BE%D0%B9-%D1%81%D1%80%D0%B5%D0%B4%D0%B5","type":"heading","text":"Особенности работы с библиотекой rtpkcs11ecp в многопоточной среде"},{"type":"paragraph","inlineContent":[{"text":"Настроим синхронизацию вызовов функций библиотеки с помощью GCD.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Для этого:"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Шаг 1"}]},{"text":". Создайте обёртку над библиотекой.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import Foundation","","struct Pkcs11ThreadSafe {}"]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Шаг 2"}]},{"type":"text","text":". Добавьте поддержку функции "},{"type":"codeVoice","code":"C_WaitForSlotEvent"},{"text":", которая будет выполняться в очереди ","type":"text"},{"type":"codeVoice","code":"wfseQueue"},{"text":".","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Это гарантирует, что функция не будет вызвана одновременно из нескольких потоков одного приложения."}],"type":"paragraph"},{"code":["import Foundation","","struct Pkcs11ThreadSafe {","    private static let wfseQueue = DispatchQueue(label: \"com.pkcs11safe.wfsequeue\")","","    @discardableResult","    static func WaitForSlotEvent(","        _ flags: CK_FLAGS,","        _ pSlot: CK_SLOT_ID_PTR!,","        _ pReserved: CK_VOID_PTR!","    ) -> CK_RV {","        return wfseQueue.sync {","            C_WaitForSlotEvent(flags, pSlot, pReserved)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Шаг 3"}],"type":"strong"},{"type":"text","text":". Аналогично оберните оставшиеся необходимые функции в очередь "},{"code":"defaultQueue","type":"codeVoice"},{"text":", чтобы они могли работать параллельно с функцией ","type":"text"},{"code":"C_WaitForSlotEvent","type":"codeVoice"},{"text":", но не друг с другом, поскольку ","type":"text"},{"type":"codeVoice","code":"C_Finalize"},{"type":"text","text":" не должна вызываться параллельно с любой другой функцией, кроме "},{"code":"C_WaitForSlotEvent","type":"codeVoice"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["import Foundation","","struct Pkcs11ThreadSafe {","    private static let defaultQueue = DispatchQueue(label: \"com.pkcs11safe.defaultqueue\", attributes: .concurrent)","    private static let wfseQueue = DispatchQueue(label: \"com.pkcs11safe.wfsequeue\")","","    @discardableResult","    static func WaitForSlotEvent(","        _ flags: CK_FLAGS,","        _ pSlot: CK_SLOT_ID_PTR!,","        _ pReserved: CK_VOID_PTR!","    ) -> CK_RV {","        return wfseQueue.sync {","            C_WaitForSlotEvent(flags, pSlot, pReserved)","        }","    }","","    @discardableResult","    static func Initialize(_ pInitArgs: CK_VOID_PTR!) -> CK_RV {","        return defaultQueue.sync {","            C_Initialize(pInitArgs)","        }","    }","","    @discardableResult","    static func Finalize(_ pReserved: CK_VOID_PTR!) -> CK_RV {","        return defaultQueue.sync(flags: .barrier) {","            C_Finalize(pReserved)","        }","    }","","    @discardableResult","    static func GetSlotList(","        _ tokenPresent: CK_BBOOL,","        _ pSlotList: CK_SLOT_ID_PTR!,","        _ pulCount: CK_ULONG_PTR!","    ) -> CK_RV {","        return defaultQueue.sync {","            C_GetSlotList(tokenPresent, pSlotList, pulCount)","        }","    }","","    @discardableResult","    static func GetSlotInfo(","        _ slotID: CK_SLOT_ID,","        _ pInfo: CK_SLOT_INFO_PTR!","    ) -> CK_RV {","        return defaultQueue.sync {","            C_GetSlotInfo(slotID, pInfo)","        }","    }","","    @discardableResult","    static func GetTokenInfo(","        _ slotID: CK_SLOT_ID,","        _ pInfo: CK_TOKEN_INFO_PTR!","    ) -> CK_RV {","        return defaultQueue.sync {","            C_GetTokenInfo(slotID, pInfo)","        }","    }","}"]},{"anchor":"%D0%9C%D0%BE%D0%BD%D0%B8%D1%82%D0%BE%D1%80%D0%B8%D0%BD%D0%B3-%D0%A0%D1%83%D1%82%D0%BE%D0%BA%D0%B5%D0%BD%D0%BE%D0%B2","text":"Мониторинг Рутокенов","type":"heading","level":2},{"inlineContent":[{"text":"Теперь перейдем к настройке мониторинга Рутокенов.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Шаг 1"}],"type":"strong"},{"type":"text","text":". В файле "},{"type":"emphasis","inlineContent":[{"type":"text","text":"MainViewModel.swift"}]},{"type":"text","text":" замените использование асинхронных функций на использование асинхронных очередей и соответствующего класса синхронизации вызовов библиотеки."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import Foundation","","class MainViewModel: ObservableObject {","    @Published private(set) var tokens: [CK_SLOT_ID: Pkcs11Token] = [:]","    @Published private(set) var errorText: String?","    @Published private(set) var isMonitoringEnabled: Bool = false","","    func startMonitoring() {","        guard !isMonitoringEnabled else { return }","        isMonitoringEnabled = true","        DispatchQueue.global().async {","            do {","                var initArgs = CK_C_INITIALIZE_ARGS()","                initArgs.flags = UInt(CKF_OS_LOCKING_OK)","","                var rv = Pkcs11ThreadSafe.Initialize(&initArgs)","                guard rv == CKR_OK else {","                    throw Pkcs11Error.internalError(rv: rv)","                }","","                var ctr: UInt = 0","                rv = Pkcs11ThreadSafe.GetSlotList(CK_BBOOL(CK_TRUE), nil, &ctr)","                guard rv == CKR_OK else {","                    throw Pkcs11Error.internalError(rv: rv)","                }","","                if ctr != 0  {","                    var slots: [CK_SLOT_ID]","                    repeat {","                        slots = Array(repeating: CK_SLOT_ID(0), count: Int(ctr))","                        rv = Pkcs11ThreadSafe.GetSlotList(CK_BBOOL(CK_TRUE), &slots, &ctr)","                    } while rv == CKR_BUFFER_TOO_SMALL","","                    guard rv == CKR_OK else {","                        throw Pkcs11Error.internalError(rv: rv)","                    }","","                    DispatchQueue.main.async {","                        do {","                            for i in 0..<Int(ctr) where try self.isPresent(slots[i]) {","                                self.tokens[slots[i]] = try Pkcs11Token(with: slots[i])","                            }","                        } catch {","                            self.setError(error as? Pkcs11Error)","                        }","                    }","                }","            } catch {","                self.setError(error as? Pkcs11Error)","            }","","            while true {","                var slot = CK_SLOT_ID()","                let rv = Pkcs11ThreadSafe.WaitForSlotEvent(0, &slot, nil)","","                guard rv != CKR_CRYPTOKI_NOT_INITIALIZED else {","                    break","                }","                guard rv == CKR_OK else { continue }","","                do {","                    let isPresent = try self.isPresent(slot)","                    let newToken = isPresent ? try Pkcs11Token(with: slot) : nil","","                    DispatchQueue.main.async {","                        self.tokens.removeValue(forKey: slot)","                        if newToken != nil {","                            self.tokens[slot] = newToken","                        }","                    }","                } catch {","                    self.setError(error as? Pkcs11Error)","                }","            }","        }","    }","","    func setError(_ error: Pkcs11Error?) {","        DispatchQueue.main.async {","            self.errorText = error?.description","        }","    }","","    func stopMonitoring() {","        guard isMonitoringEnabled else { return }","        isMonitoringEnabled = false","        tokens.removeAll()","        Pkcs11ThreadSafe.Finalize(nil)","    }","","    private func isPresent(_ slot: CK_SLOT_ID) throws(Pkcs11Error) -> Bool {","        var slotInfo = CK_SLOT_INFO()","        let rv = Pkcs11ThreadSafe.GetSlotInfo(slot, &slotInfo)","        guard rv == CKR_OK else {","            throw Pkcs11Error.internalError(rv: rv)","        }","        return slotInfo.flags & UInt(CKF_TOKEN_PRESENT) != 0","    }","}","","extension MainViewModel: @unchecked Sendable {}"]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Шаг 2"}]},{"type":"text","text":". В файле "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Pkcs11Token.swift"}]},{"type":"text","text":" удалите асинхронность и замените "},{"type":"codeVoice","code":"Pkcs11Actor"},{"text":", отвечающий за вызов библиотеки, на ","type":"text"},{"type":"codeVoice","code":"Pkcs11ThreadSafe"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","","","struct Pkcs11Token: Identifiable {","    \/\/ ...","","    init(with slot: CK_SLOT_ID) throws(Pkcs11Error){","        var tokenInfo = CK_TOKEN_INFO()","        let rv = Pkcs11ThreadSafe.GetTokenInfo(slot, &tokenInfo)","        \/\/ ...","    }","}"],"type":"codeListing"}]}],"metadata":{"images":[{"type":"icon","identifier":"WorkWithTokenLogo.png"}],"color":{"standardColorIdentifier":"blue"},"roleHeading":"Статья","role":"article","title":"Мониторинг Рутокенов c GrandCentralDispatch"},"identifier":{"interfaceLanguage"