"text":"Настроим синхронизацию вызовов функций библиотеки с помощью GCD.","type":"text"}]},{"inlineContent":[{"text":"Для этого:","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Шаг 1"}],"type":"strong"},{"type":"text","text":". Создайте обёртку над библиотекой."}]},{"type":"codeListing","code":["import Foundation","","struct Pkcs11ThreadSafe {}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Шаг 2"}]},{"type":"text","text":". Добавьте поддержку функции "},{"code":"C_WaitForSlotEvent","type":"codeVoice"},{"text":", которая будет выполняться в очереди ","type":"text"},{"code":"wfseQueue","type":"codeVoice"},{"type":"text","text":"."},{"text":" ","type":"text"},{"type":"text","text":"Это гарантирует, что функция не будет вызвана одновременно из нескольких потоков одного приложения."}]},{"code":["import Foundation","","struct Pkcs11ThreadSafe {","    private static let wfseQueue = DispatchQueue(label: \"com.pkcs11safe.wfsequeue\")","","    @discardableResult","    static func WaitForSlotEvent(","        _ flags: CK_FLAGS,","        _ pSlot: CK_SLOT_ID_PTR!,","        _ pReserved: CK_VOID_PTR!","    ) -> CK_RV {","        return wfseQueue.sync {","            C_WaitForSlotEvent(flags, pSlot, pReserved)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Шаг 3"}],"type":"strong"},{"text":". Аналогично оберните оставшиеся необходимые функции в очередь ","type":"text"},{"type":"codeVoice","code":"defaultQueue"},{"type":"text","text":", чтобы они могли работать параллельно с функцией "},{"type":"codeVoice","code":"C_WaitForSlotEvent"},{"type":"text","text":", но не друг с другом, поскольку "},{"type":"codeVoice","code":"C_Finalize"},{"type":"text","text":" не должна вызываться параллельно с любой другой функцией, кроме "},{"type":"codeVoice","code":"C_WaitForSlotEvent"},{"text":".","type":"text"}]},{"syntax":"swift","code":["import Foundation","","struct Pkcs11ThreadSafe {","    private static let defaultQueue = DispatchQueue(label: \"com.pkcs11safe.defaultqueue\", attributes: .concurrent)","    private static let wfseQueue = DispatchQueue(label: \"com.pkcs11safe.wfsequeue\")","","    @discardableResult","    static func WaitForSlotEvent(","        _ flags: CK_FLAGS,","        _ pSlot: CK_SLOT_ID_PTR!,","        _ pReserved: CK_VOID_PTR!","    ) -> CK_RV {","        return wfseQueue.sync {","            C_WaitForSlotEvent(flags, pSlot, pReserved)","        }","    }","","    @discardableResult","    static func Initialize(_ pInitArgs: CK_VOID_PTR!) -> CK_RV {","        return defaultQueue.sync {","            C_Initialize(pInitArgs)","        }","    }","","    @discardableResult","    static func Finalize(_ pReserved: CK_VOID_PTR!) -> CK_RV {","        return defaultQueue.sync(flags: .barrier) {","            C_Finalize(pReserved)","        }","    }","","    @discardableResult","    static func GetSlotList(","        _ tokenPresent: CK_BBOOL,","        _ pSlotList: CK_SLOT_ID_PTR!,","        _ pulCount: CK_ULONG_PTR!","    ) -> CK_RV {","        return defaultQueue.sync {","            C_GetSlotList(tokenPresent, pSlotList, pulCount)","        }","    }","","    @discardableResult","    static func GetSlotInfo(","        _ slotID: CK_SLOT_ID,","        _ pInfo: CK_SLOT_INFO_PTR!","    ) -> CK_RV {","        return defaultQueue.sync {","            C_GetSlotInfo(slotID, pInfo)","        }","    }","","    @discardableResult","    static func GetTokenInfo(","        _ slotID: CK_SLOT_ID,","        _ pInfo: CK_TOKEN_INFO_PTR!","    ) -> CK_RV {","        return defaultQueue.sync {","            C_GetTokenInfo(slotID, pInfo)","        }","    }","}"],"type":"codeListing"},{"type":"heading","anchor":"%D0%9C%D0%BE%D0%BD%D0%B8%D1%82%D0%BE%D1%80%D0%B8%D0%BD%D0%B3-%D0%A0%D1%83%D1%82%D0%BE%D0%BA%D0%B5%D0%BD%D0%BE%D0%B2","text":"Мониторинг Рутокенов","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Теперь перейдем к настройке мониторинга Рутокенов."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Шаг 1"}],"type":"strong"},{"type":"text","text":". В файле "},{"inlineContent":[{"type":"text","text":"MainViewModel.swift"}],"type":"emphasis"},{"type":"text","text":" замените использование асинхронных функций на использование асинхронных очередей и соответствующего класса синхронизации вызовов библиотеки."}]},{"syntax":"swift","code":["import Foundation","","class MainViewModel: ObservableObject {","    @Published private(set) var tokens: [CK_SLOT_ID: Pkcs11Token] = [:]","    @Published private(set) var errorText: String?","    @Published private(set) var isMonitoringEnabled: Bool = false","","    func startMonitoring() {","        guard !isMonitoringEnabled else { return }","        isMonitoringEnabled = true","        DispatchQueue.global().async {","            do {","                var initArgs = CK_C_INITIALIZE_ARGS()","                initArgs.flags = UInt(CKF_OS_LOCKING_OK)","","                var rv = Pkcs11ThreadSafe.Initialize(&initArgs)","                guard rv == CKR_OK else {","                    throw Pkcs11Error.internalError(rv: rv)","                }","","                var ctr: UInt = 0","                rv = Pkcs11ThreadSafe.GetSlotList(CK_BBOOL(CK_TRUE), nil, &ctr)","                guard rv == CKR_OK else {","                    throw Pkcs11Error.internalError(rv: rv)","                }","","                if ctr != 0  {","                    var slots: [CK_SLOT_ID]","                    repeat {","                        slots = Array(repeating: CK_SLOT_ID(0), count: Int(ctr))","                        rv = Pkcs11ThreadSafe.GetSlotList(CK_BBOOL(CK_TRUE), &slots, &ctr)","                    } while rv == CKR_BUFFER_TOO_SMALL","","                    guard rv == CKR_OK else {","                        throw Pkcs11Error.internalError(rv: rv)","                    }","","                    DispatchQueue.main.async {","                        do {","                            for i in 0..<Int(ctr) where try self.isPresent(slots[i]) {","                                self.tokens[slots[i]] = try Pkcs11Token(with: slots[i])","                            }","                        } catch {","                            self.setError(error as? Pkcs11Error)","                        }","                    }","                }","            } catch {","                self.setError(error as? Pkcs11Error)","            }","","            while true {","                var slot = CK_SLOT_ID()","                let rv = Pkcs11ThreadSafe.WaitForSlotEvent(0, &slot, nil)","","                guard rv != CKR_CRYPTOKI_NOT_INITIALIZED else {","                    break","                }","                guard rv == CKR_OK else { continue }","","                do {","                    let isPresent = try self.isPresent(slot)","                    let newToken = isPresent ? try Pkcs11Token(with: slot) : nil","","                    DispatchQueue.main.async {","                        self.tokens.removeValue(forKey: slot)","                        if newToken != nil {","                            self.tokens[slot] = newToken","                        }","                    }","                } catch {","                    self.setError(error as? Pkcs11Error)","                }","            }","        }","    }","","    func setError(_ error: Pkcs11Error?) {","        DispatchQueue.main.async {","            self.errorText = error?.description","        }","    }","","    func stopMonitoring() {","        guard isMonitoringEnabled else { return }","        isMonitoringEnabled = false","        tokens.removeAll()","        Pkcs11ThreadSafe.Finalize(nil)","    }","","    private func isPresent(_ slot: CK_SLOT_ID) throws(Pkcs11Error) -> Bool {","        var slotInfo = CK_SLOT_INFO()","        let rv = Pkcs11ThreadSafe.GetSlotInfo(slot, &slotInfo)","        guard rv == CKR_OK else {","            throw Pkcs11Error.internalError(rv: rv)","        }","        return slotInfo.flags & UInt(CKF_TOKEN_PRESENT) != 0","    }","}","","extension MainViewModel: @unchecked Sendable {}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Шаг 2"}],"type":"strong"},{"type":"text","text":". В файле "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Pkcs11Token.swift"}]},{"text":" удалите асинхронность и замените ","type":"text"},{"type":"codeVoice","code":"Pkcs11Actor"},{"type":"text","text":", отвечающий за вызов библиотеки, на "},{"type":"codeVoice","code":"Pkcs11ThreadSafe"},{"type":"text","text":"."}]},{"code":["import Foundation","","","struct Pkcs11Token: Identifiable {","    \/\/ ...","","    init(with slot: CK_SLOT_ID) throws(Pkcs11Error){","        var tokenInfo = CK_TOKEN_INFO()","        let rv = Pkcs11ThreadSafe.GetTokenInfo(slot, &tokenInfo)","        \/\/ ...","    }","}"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Documentation\/documentation\/Main"]]},"references":{"WorkWithTokenLogo.png":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/Documentation\/WorkWithTokenLogo.png"}],"identifier":"WorkWithTokenLogo.png","alt":null},"doc://Documentation/tutorials/Documentation/TokenSearch":{"title":"Мониторинг Рутокенов","identifier":"doc:\/\/Documentation\/tutorials\/Documentation\/TokenSearch","url":"\/tutorials\/documentation\/tokensearch","estimatedTime":"20мин","kind":"project","abstract":[{"type":"text","text":"В этом уроке вы узнаете, как с помощью библиотеки rtpkcs11ecp отслеживать подключение и отключение Рутокенов."}],"role":"project","type":"topic"},"doc://Documentation/documentation/Main":{"identifier":"doc:\/\/Documentation\/documentation\/Main","url":"\/documentation\/main","title":"iOS SDK Рутокен","type